generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Setting {
  key        String  @id
  value      String?
  jsonSchema String?
}

model Message {
  id Int @id @default(autoincrement())

  type     MessageType @default(USER)
  request  String
  response String

  tokens    Int
  createdAt DateTime @default(now())
}

enum MessageType {
  USER
  TIMER
}

model Timer {
  id       Int      @id @default(autoincrement())
  name     String
  action   String
  runAt    DateTime
  executed Boolean  @default(false)

  createdAt DateTime @default(now())
}
