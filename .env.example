# Port the API (and the dashboard, when DASHBOARD_DIR is set) listens on
PORT=3000
NODE_ENV=production
DATABASE_URL="file:./prisma/dev.db"

# Shared with the voice workers (ASSISTANT_API_KEY in worker/.env)
SECRET_TOKEN=

# Signs dashboard sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: public address of this instance, for example https://lisa.example.com.
# Set it when LISA sits behind a reverse proxy; without it the address is taken
# from each request
# BETTER_AUTH_URL=

# Optional: folder with the exported web dashboard (`bun run build:web` in the
# dashboard repository). LISA then serves it on the same port as the API
# DASHBOARD_DIR=../LisaWeb/dist

# Optional: other origins a browser may call the API from, comma separated.
# Only needed when the web dashboard is hosted somewhere else than this instance
# TRUSTED_ORIGINS=https://dashboard.example.com

# Optional: registers an example device, useful to try the dashboard
# TESTING=true
