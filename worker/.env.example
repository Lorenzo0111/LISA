# LocalAssistant API URL
ASSISTANT_API_URL=http://localhost:3000
ASSISTANT_API_KEY=12345

# Optional: Name this listener uses to receive notifications (timers, reminders).
# Give each listener its own name when you run more than one
# ASSISTANT_CHANNEL=voice

# Optional: Audio device ID (run with --list-devices to find your device)
# AUDIO_DEVICE_ID=0

# Optional: Wake word keyword, plus other spellings Whisper may produce for it
# WAKE_WORD=lisa
# WAKE_WORD_ALIASES=liza,lysa

# Optional: Whisper language code (en, it, ...). Leave unset for auto-detect
# LISTENER_LANGUAGE=en

# Optional: Whisper models (tiny, base, small, ...). On a Raspberry Pi prefer
# WAKE_MODEL=tiny, TRANSCRIPTION_MODEL=base and WHISPER_BEAM_SIZE=1
# WAKE_MODEL=tiny
# TRANSCRIPTION_MODEL=small
# WHISPER_BEAM_SIZE=5
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_THREADS=0

# Optional: Speech probability (0-1) needed to start capturing
# VAD_THRESHOLD=0.5

# Optional: Seconds of silence that end a command. Raise it if you get cut off
# END_SILENCE_SECONDS=0.8

# Optional: Print everything that is heard and save each utterance to worker/debug
# LISTENER_DEBUG=1

# Optional: Text to speech. TTS_ENGINE is piper, system or none.
# PIPER_VOICE is a voice name from https://huggingface.co/rhasspy/piper-voices
# (downloaded to worker/voices on first use) or a path to an .onnx voice file
# TTS_ENGINE=piper
# PIPER_VOICE=en_US-lessac-medium
# TTS_SPEED=1.0
